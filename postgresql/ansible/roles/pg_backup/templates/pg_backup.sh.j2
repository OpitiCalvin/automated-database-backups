#!/bin/bash
# {{ ansible_managed }}
# Deployed by the pg_backup Ansible role - do not edit by hand, edit the
# template/vars in the ansible role instead.

# --- CONFIGURATION---
DB_USER="{{ pg_backup_db_user }}"
DB_HOST="{{ pg_backup_host }}"
DB_PORT="{{ pg_backup_port }}"
BACKUP_DIR="{{ pg_backup_dir }}"
LOG_DIR="{{ pg_backup_log_dir }}"
DAYS_TO_KEEP={{ pg_backup_days_to_keep }}

# Pinned to the exact PostgreSQL {{ pg_backup_server_major }} client install
# matching the running server (resolved by the pg_backup Ansible role at
# deploy time). Deliberately NOT using bare pg_dump/pg_restore/psql: when
# multiple client versions are installed side by side, the distro's
# multi-version wrapper can resolve them inconsistently (e.g. pg_dump
# picking one version via its -h/-p hint, pg_restore -l picking another
# with no such hint to go on) - producing dumps one version writes that
# another can't read ("unsupported version (x.x) in file header").
PG_BIN_DIR="{{ pg_backup_pg_bin_dir }}"
PG_DUMP="$PG_BIN_DIR/pg_dump"
PG_DUMPALL="$PG_BIN_DIR/pg_dumpall"
PG_RESTORE="$PG_BIN_DIR/pg_restore"
PSQL="$PG_BIN_DIR/psql"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
LOG_FILE="$LOG_DIR/backup_${TIMESTAMP}.log"

{% if pg_backup_require_mount %}
# {{ pg_backup_mount_path }} is a separate mount (NAS/external disk). Refuse
# to proceed if it isn't attached - otherwise mkdir -p below would silently
# create the backup/log directories on the root filesystem instead, and
# backups would "succeed" while quietly landing on the wrong disk.
if ! mountpoint -q "{{ pg_backup_mount_path }}"; then
    echo "ERROR: {{ pg_backup_mount_path }} is not mounted. Refusing to write backups to the wrong filesystem." >&2
    exit 1
fi

{% endif %}
# Create or ensure backup and log directories exist; abort rather than
# silently continue if either can't actually be created.
if ! mkdir -p "$BACKUP_DIR"; then
    echo "ERROR: Failed to create backup directory: $BACKUP_DIR" >&2
    exit 1
fi
if ! mkdir -p "$LOG_DIR"; then
    echo "ERROR: Failed to create log directory: $LOG_DIR" >&2
    exit 1
fi

# --- LOGGING FUNCTION ---
# This function prints to the terminal AND appends to the log file with a timestamp
log_message() {
    local LOG_LEVEL="$1"
    local MESSAGE="$2"
    local TIME=$(date +"%Y-%m-%d %H:%M:%S")
    echo "[$TIME] [$LOG_LEVEL] $MESSAGE" | tee -a "$LOG_FILE"
}

log_message "INFO" "=== Starting Hybrid PostgreSQL Backup Process ==="
log_message "INFO" "Logs are being written to: $LOG_FILE"
log_message "INFO" "pg_dump: $("$PG_DUMP" --version) | pg_restore: $("$PG_RESTORE" --version)"

# 1. Backup Global Objects (Roles, Permissions, Tablespaces)
GLOBAL_FILE="$BACKUP_DIR/globals_$TIMESTAMP.sql.gz"
log_message "INFO" "Backing up global cluster objects..."
"$PG_DUMPALL" -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" --globals-only | gzip > "$GLOBAL_FILE"

if [ ${PIPESTATUS[0]} -eq 0 ]; then
    log_message "INFO" "Global cluster objects backed up successfully."
else
    log_message "ERROR" "Failed to back up global cluster objects."
fi

# 2. Get a list of all user databases (excluding system templates)
log_message "INFO" "Fetching database list..."
DB_LIST=$("$PSQL" -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d postgres -t -A -c "SELECT datname FROM pg_database WHERE datistemplate = false AND datallowconn = true;")

# 3. Loop through each database and perform an individual custom-format backup
for DB in $DB_LIST; do
    log_message "INFO" "----------------------------------------"
    log_message "INFO" "Starting backup for database: $DB"
    BACKUP_FILE="$BACKUP_DIR/${DB}_$TIMESTAMP.dump"

    # Using Custom format (-F c) which compresses automatically and allows flexible restores
    "$PG_DUMP" -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -F c -b -v -f "$BACKUP_FILE" "$DB"

    if [ $? -eq 0 ]; then
        log_message "INFO" "Backup file created for $DB. Running validation check..."

        # --- VALIDATION STEP ---
        # pg_restore -l lists the contents; capture stderr so a failure tells us *why*.
        RESTORE_CHECK_OUTPUT=$("$PG_RESTORE" -l "$BACKUP_FILE" 2>&1 >/dev/null)
        RESTORE_CHECK_STATUS=$?

        if [ $RESTORE_CHECK_STATUS -eq 0 ]; then
            log_message "SUCCESS" "VALIDATION PASSED: $BACKUP_FILE is healthy."
        else
            log_message "CRITICAL" "VALIDATION FAILED: $BACKUP_FILE appears to be corrupted! pg_restore said: $RESTORE_CHECK_OUTPUT"
            # Rename the bad backup so it's obvious it's broken
            mv "$BACKUP_FILE" "${BACKUP_FILE}.CORRUPT"
        fi

    else
        log_message "ERROR" "Backup generation failed for database: $DB"
    fi
done

log_message "INFO" "----------------------------------------"

# 4. Clean up backups older than specified days
log_message "INFO" "Cleaning up database backups older than $DAYS_TO_KEEP days..."
find "$BACKUP_DIR" -type f \( -name "globals_*.sql.gz" -o -name "*.dump" \) -mtime +$DAYS_TO_KEEP -delete

# 5. Clean up old log files (keep logs for the same number of days)
log_message "INFO" "Cleaning up log files older than $DAYS_TO_KEEP days..."
find "$LOG_DIR" -type f -name "backup_*.log" -mtime +$DAYS_TO_KEEP -delete

log_message "INFO" "=== Backup Process Completed ==="
